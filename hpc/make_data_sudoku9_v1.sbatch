#!/bin/bash
# ============================================================================
# Build the 9x9 sudoku dataset.
#
#   sbatch hpc/make_data_sudoku9_v1.sbatch
#   N=20000000 OUTDIR=data/sudoku9_v2 \
#       sbatch hpc/make_data_sudoku9_v1.sbatch
#
# CPU-bound; it never touches the GPU. A CPU partition works equally well.
#
# ~11 MINUTES for 10M rows, against ~2 for sudoku6_v2's 5M. The difference is
# not the row count. sudoku6_fast draws an exactly-uniform valid grid in 3 us
# by indexing a cached enumeration of the 39,168 reduced grids. That table does
# not exist at 9x9 -- 6,670,903,752,021,072,936,960 / 9! = 1.84e16 reduced
# grids -- so every injected grid is generated by randomised backtracking at
# ~0.25 ms and then hit with a uniform element of the symmetry group
# (|G| = 1,218,998,108,160). 500,000 injected grids is ~2 minutes of that;
# the rest is the weak-row generator and the distinctness count.
#
# See tilt/sudoku9_fast.py for exactly how uniform this is and is not. Short
# version: exactly uniform WITHIN each symmetry orbit, biased only in the orbit
# label, and `success_rate_exact` is unaffected because it depends only on
# p_inject.
#
# WHY 10M: memorisation is driven by how many times each DISTINCT valid grid is
# seen. sudoku6_v1's 7,511 grids at ~9,800 exposures each produced 33.6%
# verbatim reproduction (2,522x chance); sudoku6_v2's 248,778 at ~296 measured
# clean. 10M rows here gives ~500,000 distinct grids at ~148 exposures over a
# 180k-step run at bs=8192 -- twice v2's margin, for a harder problem.
# p_inject stays at 0.05: the reward must remain rare, that is the point.
#
# CONTROL ARM: GEN=mrv builds the same dataset with the other seed generator.
# The two disagree on a G-invariant statistic at z = 10.2, so neither is
# uniform; building both and checking whether validity and tau_eff move is the
# measurement that bounds how much that matters. It costs 3.4x on generation
# (~35 min), nothing on training.
# ============================================================================

#SBATCH --job-name=s9data
#SBATCH --account=<YOUR_ACCOUNT>
#SBATCH --partition=<GPU_PARTITION>
#SBATCH --gpus=1
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=5
#SBATCH --time=01:00:00
#SBATCH --output=logs/%x-%j.out
#SBATCH --error=logs/%x-%j.err

set -euo pipefail

AI_MODULE="${AI_MODULE:-}"          # optional: cluster PyTorch module to load
CODE_DIR="${CODE_DIR:-${SLURM_SUBMIT_DIR:-$PWD}}"   # repo root
VENV_PATH="${VENV_PATH:-$CODE_DIR/.venv}"

N="${N:-10000000}"
OUTDIR="${OUTDIR:-data/sudoku9_v1}"
SEED="${SEED:-5209}"
ROW_NOISE="${ROW_NOISE:-0.02}"
P_INJECT="${P_INJECT:-0.05}"
FORMAT="${FORMAT:-npy}"
GEN="${GEN:-rowmajor}"
CHUNK="${CHUNK:-500000}"

echo "=========================================================="
echo "job id   : $SLURM_JOB_ID"
echo "node     : $(hostname)"
echo "started  : $(date)"
echo "n        : $N"
echo "outdir   : $OUTDIR"
echo "p_inject : $P_INJECT   (unchanged -- the reward stays rare)"
echo "gen      : $GEN"
echo "format   : $FORMAT"
echo "=========================================================="

if [ -n "$AI_MODULE" ]; then module load "$AI_MODULE"; fi
# shellcheck disable=SC1091
source "$VENV_PATH/bin/activate"

cd "$CODE_DIR"
mkdir -p "$(dirname "$OUTDIR")" logs

if [ -e "$OUTDIR/grids.npy" ] || [ -e "$OUTDIR/train.csv" ]; then
    echo "ERROR: $OUTDIR already holds a dataset -- refusing to overwrite." >&2
    echo "       Move it aside or set OUTDIR to a new path." >&2
    exit 1
fi

SECONDS=0

# Prove the generator is sound on this machine BEFORE spending 11 minutes.
# All valid, all distinct, cell marginals flat (chi-square pooled over 81
# cells, 648 df), and the invariant statistic really is G-invariant.
echo "=== sampler selfcheck ==="
python -m tilt.sudoku9_fast

echo
python scripts/make_sudoku9_data.py \
    --n "$N" \
    --outdir "$OUTDIR" \
    --seed "$SEED" \
    --row-noise "$ROW_NOISE" \
    --p-inject "$P_INJECT" \
    --gen "$GEN" \
    --chunk "$CHUNK" \
    --format "$FORMAT"

echo
echo "=== verifying ==="
python - "$OUTDIR" <<'PY'
import json, math, sys
from pathlib import Path
d = Path(sys.argv[1])
meta = json.loads((d / "meta.json").read_text())
n, p = meta["n"], meta["p_inject"]
sr, dv = meta["success_rate"], meta.get("distinct_valid", 0)
se = math.sqrt(p * (1 - p) / n)
print(f"  n              : {n:,}")
print(f"  d              : {meta['d']}          (81 cells x 4 bits + reward)")
print(f"  success_rate   : {sr:.4%}   exact {meta['success_rate_exact_tau0']:.4%}"
      f"   ({(sr - p)/se:+.2f} SE)")
print(f"  distinct_valid : {dv:,}")
print(f"  seed_generator : {meta.get('seed_generator')}")
exp = 180_000 * 8192 * p / max(dv, 1)
print(f"  exposures/grid : {exp:,.0f}   (sudoku6_v1 9,816 -> memorised 33.6%;"
      f" v2 296 -> clean)")
if sr < 1e-6:
    sys.exit("ERROR: success_rate is 0 -- nothing to tilt against.")
if abs(sr - p) > 5 * se:
    sys.exit(f"ERROR: success_rate {sr:.4%} is >5 SE from p_inject {p:.4%}.")
if dv < 0.98 * meta["n_valid"]:
    sys.exit("ERROR: injected grids are repeating. With orbits of size 1.2e12 "
             "and no seed pool, essentially every injected grid should be "
             "distinct; anything else means the sampler is not doing what "
             "tilt/sudoku9_fast.py claims.")
print("  OK")
PY

echo
echo "elapsed  : $SECONDS s"
ls -lh "$OUTDIR"

# ---------------------------------------------------------------------------
# LOGIN-NODE ALTERNATIVE. At ~11 minutes of one core this is more than the 2
# minutes sudoku6_v2 took, and closer to what a login node should be asked to
# absorb -- prefer the job above. If you do run it interactively, use tmux so
# a dropped connection does not kill it:
#
#   source .venv/bin/activate
#   cd <repo root>
#   python scripts/make_sudoku9_data.py \
#       --n 10000000 \
#       --outdir data/sudoku9_v1 \
#       --seed 5209 --row-noise 0.02 --p-inject 0.05 --format npy
#
# Confirm success_rate ~5% and distinct_valid ~500,000.
# ---------------------------------------------------------------------------
